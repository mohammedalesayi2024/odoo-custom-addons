<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_loyalty_coupon_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.loyalty.coupon.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        icon="fa-gift"
                        type="object"
                        name="action_open_point_to_coupon_wizard"
                        invisible="total_loyalty_points &lt;= 0">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="total_loyalty_points" widget="integer"/>
                        </span>
                        <span class="o_stat_text">نقاط الولاء</span>
                        <span class="o_stat_text">تحويل إلى كوبون</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
