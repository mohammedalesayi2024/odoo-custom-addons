<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        يضيف خيار "إرسال إشعار الكوبون للعميل" داخل قائمة الإجراءات
        (⚙️ Actions) في شاشة الكوبونات القياسية بأودو (Loyalty & Promotions
        ← Coupons)، سواء من القائمة أو من داخل بطاقة كوبون محددة.
        يُستخدم للإرسال اليدوي عندما يكون "الإرسال التلقائي" معطّلاً من
        الإعدادات، أو لإعادة إرسال كوبون سابق.
    -->
    <record id="action_send_coupon_notification_manual" model="ir.actions.server">
        <field name="name">إرسال إشعار الكوبون للعميل</field>
        <field name="model_id" ref="loyalty.model_loyalty_card"/>
        <field name="binding_model_id" ref="loyalty.model_loyalty_card"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_send_coupon_notification()</field>
    </record>

</odoo>
