<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        علامة تصنيف ثابتة واحدة يديرها النظام تلقائيًا: تُضاف لكل
        منتج مؤهل لاستخدام كوبون تحويل نقاط الولاء (أي منتج خارج
        الفئات المستثناة)، وتُزال من غيره. الهدف تجنّب سرد آلاف
        المنتجات يدويًا في شاشة المكافأة - يكفي وجود هذا التاق الواحد
        في حقل "علامات تصنيف المنتجات المشمولة في الخصم".
        لا تُعدَّل هذه العلامة يدويًا على أي منتج - يُعاد حسابها بالكامل
        تلقائيًا في كل مرة تُحفظ فيها "الفئات المستثناة" من شاشة
        الإعدادات.
    -->
    <record id="product_tag_loyalty_coupon_eligible" model="product.tag">
        <field name="name">مؤهل لكوبون تحويل نقاط الولاء</field>
    </record>

</odoo>
