<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        سجل الإعدادات الوحيد (Singleton). القيم الافتراضية هنا تطابق
        السياسة المتفق عليها حاليًا، وتقدر تُعدَّل مباشرة من الواجهة
        (القائمة: سياسة نقاط الولاء ← الإعدادات) دون الحاجة للكود.
        فئات "مستثناة من الاكتساب" و"مستثناة من استخدام الكوبون" تُترك
        فارغة هنا عمدًا، لأنها تعتمد على فئات المنتجات الفعلية الخاصة
        بكل عميل يُثبَّت عنده الموديول.
    -->
    <record id="default_loyalty_policy_settings" model="loyalty.policy.settings">
        <field name="name">الإعدادات الافتراضية</field>
        <field name="points_currency_unit">20.0</field>
        <field name="use_tax_included_amount" eval="False"/>
        <field name="coupon_trigger_points">100.0</field>
        <field name="coupon_value_currency">10.0</field>
        <field name="block_coupon_with_other_discount_sales" eval="True"/>
    </record>

</odoo>
