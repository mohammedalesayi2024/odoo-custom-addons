<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_loyalty_point_to_coupon_wizard_form" model="ir.ui.view">
        <field name="name">loyalty.point.to.coupon.wizard.form</field>
        <field name="model">loyalty.point.to.coupon.wizard</field>
        <field name="arch" type="xml">
            <form string="تحويل نقاط الولاء إلى كوبون">
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="loyalty_card_id"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="current_points"/>
                </group>
                <group string="بيانات التحويل">
                    <field name="points_to_convert"/>
                    <field name="points_per_currency"/>
                    <field name="coupon_value" widget="monetary"/>
                    <field name="send_notification"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="تأكيد وإنشاء الكوبون"
                            type="object"
                            class="btn-primary"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_loyalty_point_to_coupon_wizard" model="ir.actions.act_window">
        <field name="name">تحويل نقاط الولاء إلى كوبون</field>
        <field name="res_model">loyalty.point.to.coupon.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
