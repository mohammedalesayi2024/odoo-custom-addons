<odoo>
    <!-- Odoo 19 uses res.groups.privilege instead of res.groups.category_id. -->
    <record id="privilege_bank_smart_scanner" model="res.groups.privilege">
        <field name="name">Bank Smart Scanner</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
    </record>

    <record id="group_bank_scanner_user" model="res.groups">
        <field name="name">Bank Scanner User</field>
        <field name="privilege_id" ref="privilege_bank_smart_scanner"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
    <record id="group_bank_scanner_manager" model="res.groups">
        <field name="name">Bank Scanner Manager</field>
        <field name="privilege_id" ref="privilege_bank_smart_scanner"/>
        <field name="implied_ids" eval="[(4, ref('bank_smart_scanner.group_bank_scanner_user')), (4, ref('account.group_account_manager'))]"/>
    </record>

    <record id="rule_bank_scanner_profile_company" model="ir.rule">
        <field name="name">Bank scanner profiles: allowed companies</field>
        <field name="model_id" ref="model_bank_scanner_profile"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('bank_smart_scanner.group_bank_scanner_user'))]"/>
    </record>
    <record id="rule_bank_scanner_session_company" model="ir.rule">
        <field name="name">Bank scanner sessions: allowed companies</field>
        <field name="model_id" ref="model_bank_scanner_session"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('bank_smart_scanner.group_bank_scanner_user'))]"/>
    </record>
    <record id="rule_bank_scanner_transaction_company" model="ir.rule">
        <field name="name">Bank scanner transactions: allowed companies</field>
        <field name="model_id" ref="model_bank_scanner_transaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('bank_smart_scanner.group_bank_scanner_user'))]"/>
    </record>
</odoo>
