<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_building_list" model="ir.ui.view">
        <field name="name">unit.maintenance.building.list</field>
        <field name="model">unit.maintenance.building</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="address"/>
                <field name="unit_count"/>
            </list>
        </field>
    </record>
    <record id="view_building_form" model="ir.ui.view">
        <field name="name">unit.maintenance.building.form</field>
        <field name="model">unit.maintenance.building</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_units" type="object" class="oe_stat_button" icon="fa-home">
                            <field name="unit_count" widget="statinfo" string="الوحدات"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="address"/>
                        </group>
                        <group>
                            <field name="map_url" widget="url"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_building_search" model="ir.ui.view">
        <field name="name">unit.maintenance.building.search</field>
        <field name="model">unit.maintenance.building</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="archived" string="المؤرشفة" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_building" model="ir.actions.act_window">
        <field name="name">المباني</field>
        <field name="res_model">unit.maintenance.building</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
