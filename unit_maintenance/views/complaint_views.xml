<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_complaint_list" model="ir.ui.view">
        <field name="name">unit.maintenance.complaint.list</field>
        <field name="model">unit.maintenance.complaint</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'rejected'" decoration-bf="state == 'new'">
                <field name="name"/>
                <field name="create_date"/>
                <field name="building_id"/>
                <field name="unit_id"/>
                <field name="owner_id"/>
                <field name="phone"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_complaint_form" model="ir.ui.view">
        <field name="name">unit.maintenance.complaint.form</field>
        <field name="model">unit.maintenance.complaint</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_convert" string="تحويل إلى طلب صيانة" type="object" class="btn-primary"
                            invisible="state != 'new'"/>
                    <button name="action_reject" string="رفض" type="object" invisible="state != 'new'"/>
                    <button name="action_open_request" string="فتح طلب الصيانة" type="object"
                            invisible="state != 'converted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,converted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="unit_id"/>
                            <field name="building_id"/>
                            <field name="owner_id"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="request_id"/>
                            <field name="ip_address"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_complaint_search" model="ir.ui.view">
        <field name="name">unit.maintenance.complaint.search</field>
        <field name="model">unit.maintenance.complaint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone"/>
                <field name="unit_id"/>
                <field name="owner_id"/>
                <filter name="new" string="جديدة" domain="[('state', '=', 'new')]"/>
            </search>
        </field>
    </record>
    <record id="action_complaint" model="ir.actions.act_window">
        <field name="name">الشكاوى</field>
        <field name="res_model">unit.maintenance.complaint</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_new': 1}</field>
    </record>
</odoo>
