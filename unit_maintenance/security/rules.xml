<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="rule_request_technician" model="ir.rule">
        <field name="name">الفني يرى طلباته فقط</field>
        <field name="model_id" ref="model_unit_maintenance_request"/>
        <field name="groups" eval="[(4, ref('group_unit_maintenance_technician'))]"/>
        <field name="domain_force">[('technician_id', '=', user.id)]</field>
    </record>
    <record id="rule_request_staff" model="ir.rule">
        <field name="name">الموظف والمدير يرون كل الطلبات</field>
        <field name="model_id" ref="model_unit_maintenance_request"/>
        <field name="groups" eval="[(4, ref('group_unit_maintenance_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_request_company" model="ir.rule">
        <field name="name">طلبات الصيانة: الشركات المتعددة</field>
        <field name="model_id" ref="model_unit_maintenance_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_unit_company" model="ir.rule">
        <field name="name">الوحدات: الشركات المتعددة</field>
        <field name="model_id" ref="model_unit_maintenance_unit"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_building_company" model="ir.rule">
        <field name="name">المباني: الشركات المتعددة</field>
        <field name="model_id" ref="model_unit_maintenance_building"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
