<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_count_history_view_list" model="ir.ui.view">
        <field name="name">stock.count.history.list</field>
        <field name="model">stock.count.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="diff_qty &lt; 0" decoration-success="diff_qty &gt; 0">
                <field name="name"/>
                <field name="date"/>
                <field name="user_id" optional="show"/>
                <field name="reason" optional="hide"/>
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="package_id" optional="hide"/>
                <field name="owner_id" optional="hide"/>
                <field name="location_id"/>
                <field name="warehouse_id" optional="hide"/>
                <field name="theoretical_qty" sum="Total"/>
                <field name="counted_qty" sum="Total"/>
                <field name="diff_qty" sum="Total"/>
                <field name="uom_id" optional="show"/>
                <field name="move_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="stock_count_history_view_form" model="ir.ui.view">
        <field name="name">stock.count.history.form</field>
        <field name="model">stock.count.history</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="reason"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="package_id"/>
                            <field name="owner_id"/>
                            <field name="location_id"/>
                            <field name="warehouse_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="theoretical_qty"/>
                            <field name="counted_qty"/>
                            <field name="diff_qty"/>
                            <field name="uom_id"/>
                        </group>
                        <group>
                            <field name="move_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_count_history_view_search" model="ir.ui.view">
        <field name="name">stock.count.history.search</field>
        <field name="model">stock.count.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="location_id"/>
                <field name="user_id"/>
                <field name="reason"/>
                <filter name="filter_shortage" string="Shortage" domain="[('diff_qty', '&lt;', 0)]"/>
                <filter name="filter_surplus" string="Surplus" domain="[('diff_qty', '&gt;', 0)]"/>
                <filter name="filter_no_diff" string="No Difference" domain="[('diff_qty', '=', 0)]"/>
                <separator/>
                <filter name="filter_date" string="Date" date="date"/>
                <group>
                    <filter name="group_name" string="Reference" context="{'group_by': 'name'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:day'}"/>
                    <filter name="group_user" string="Counted By" context="{'group_by': 'user_id'}"/>
                    <filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_location" string="Location" context="{'group_by': 'location_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="stock_count_history_view_pivot" model="ir.ui.view">
        <field name="name">stock.count.history.pivot</field>
        <field name="model">stock.count.history</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="location_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="diff_qty" type="measure"/>
                <field name="counted_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="stock_count_history_action" model="ir.actions.act_window">
        <field name="name">Inventory Count History</field>
        <field name="res_model">stock.count.history</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="stock_count_history_view_search"/>
    </record>

    <menuitem id="stock_count_history_menu"
              name="Inventory Count History"
              parent="stock.menu_warehouse_report"
              action="stock_count_history_action"
              groups="stock.group_stock_user"
              sequence="45"/>
</odoo>
