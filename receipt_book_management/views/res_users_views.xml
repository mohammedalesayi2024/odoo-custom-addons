<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_receipt_book" model="ir.ui.view">
        <field name="name">res.users.form.receipt.book</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>

        <field name="arch" type="xml">

            <xpath expr="//page[@name='access_rights']" position="after">

                <page string="Receipt Book">

                    <group>

                        <field name="receipt_book_id"/>

                    </group>

                </page>

            </xpath>

        </field>

    </record>

</odoo>