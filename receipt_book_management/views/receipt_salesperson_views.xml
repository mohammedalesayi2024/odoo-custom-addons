<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_receipt_salesperson_tree" model="ir.ui.view">
        <field name="name">receipt.salesperson.tree</field>
        <field name="model">receipt.salesperson</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="receipt_book_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_receipt_salesperson_form" model="ir.ui.view">
        <field name="name">receipt.salesperson.form</field>
        <field name="model">receipt.salesperson</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="receipt_book_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_receipt_salesperson" model="ir.actions.act_window">
        <field name="name">Salespersons</field>
        <field name="res_model">receipt.salesperson</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>