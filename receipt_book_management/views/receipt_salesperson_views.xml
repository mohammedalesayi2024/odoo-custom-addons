<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_receipt_salesperson_tree" model="ir.ui.view">
        <field name="name">receipt.salesperson.tree</field>
        <field name="model">receipt.salesperson</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="receipt_book_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_receipt_salesperson_form" model="ir.ui.view">
        <field name="name">receipt.salesperson.form</field>
        <field name="model">receipt.salesperson</field>
        <field name="arch" type="xml">
            <form string="Salesperson">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="receipt_book_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_receipt_salesperson" model="ir.actions.act_window">
        <field name="name">Salespersons</field>
        <field name="res_model">receipt.salesperson</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_receipt_salesperson"
        name="Salespersons"
        parent="account.menu_finance_configuration"
        action="action_receipt_salesperson"
        sequence="90"/>

</odoo>