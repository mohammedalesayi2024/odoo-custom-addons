<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form_receipt_book" model="ir.ui.view">
        <field name="name">account.payment.form.receipt.book</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet/group" position="inside">

                <group string="Receipt Book">

                    <field name="receipt_book_id" readonly="1"/>
                    <field name="receipt_number" readonly="1"/>

                </group>

            </xpath>

        </field>

    </record>

</odoo>