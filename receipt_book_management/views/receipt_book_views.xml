<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Tree View -->
    <!-- ========================================================= -->

    <record id="view_receipt_book_tree" model="ir.ui.view">
        <field name="name">receipt.book.tree</field>
        <field name="model">receipt.book</field>
        <field name="arch" type="xml">
            <list string="Receipt Books"
                  decoration-success="state == 'active'"
                  decoration-warning="remaining &lt;= 10 and state == 'active'"
                  decoration-danger="state == 'finished'">

                <field name="name"/>
                <field name="salesperson_id"/>
                <field name="from_number"/>
                <field name="to_number"/>
                <field name="next_number"/>
                <field name="remaining"/>
                <field name="state"/>
                <field name="company_id"/>
                <field name="received_by_accountant" widget="boolean_toggle"/>

        </list>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Form View -->
    <!-- ========================================================= -->

    <record id="view_receipt_book_form" model="ir.ui.view">
        <field name="name">receipt.book.form</field>
        <field name="model">receipt.book</field>
        <field name="arch" type="xml">

            <form string="Receipt Book">

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group>

                            <field name="salesperson_id"/>

                            <field name="company_id"
                                   groups="base.group_multi_company"/>

                            <field name="issue_date"/>

                        </group>

                        <group>

                            <field name="state" readonly="1"/>

                            <field name="from_number"/>

                            <field name="to_number"/>

                            <field name="next_number" readonly="0"/>

                            <field name="received_by_accountant"/>

                        </group>

                    </group>

                    <group string="Statistics">

                        <group>

                            <field name="total_receipts" readonly="1"/>

                            <field name="remaining" readonly="1"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Notes">

                            <field name="notes"/>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Search View -->
    <!-- ========================================================= -->

    <record id="view_receipt_book_search" model="ir.ui.view">
        <field name="name">receipt.book.search</field>
        <field name="model">receipt.book</field>
        <field name="arch" type="xml">

            <search>

                <field name="name"/>
                <field name="salesperson_id"/>

                <separator/>

                <filter string="Draft"
                        name="draft"
                        domain="[('state','=','draft')]"/>

                <filter string="Active"
                        name="active"
                        domain="[('state','=','active')]"/>

                <filter string="Finished"
                        name="finished"
                        domain="[('state','=','finished')]"/>

                <separator/>

                <group expand="0" string="Group By">

                    <filter string="Salesperson"
                            name="group_salesperson"
                            context="{'group_by':'salesperson_id'}"/>

                    <filter string="Status"
                            name="group_status"
                            context="{'group_by':'state'}"/>

                    <filter string="Company"
                            name="group_company"
                            context="{'group_by':'company_id'}"/>

                </group>

            </search>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Action -->
    <!-- ========================================================= -->

    <record id="action_receipt_book" model="ir.actions.act_window">

        <field name="name">Receipt Books</field>

        <field name="res_model">receipt.book</field>

        <field name="view_mode">tree,form</field>

        <field name="search_view_id" ref="view_receipt_book_search"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first Receipt Book
            </p>

        </field>

    </record>

</odoo>