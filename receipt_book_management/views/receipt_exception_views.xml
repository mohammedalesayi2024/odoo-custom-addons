<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Tree View -->
    <!-- ========================================================= -->

    <record id="view_receipt_exception_tree" model="ir.ui.view">
        <field name="name">receipt.exception.tree</field>
        <field name="model">receipt.exception</field>
        <field name="arch" type="xml">

            <list string="Receipt Exceptions" create="0">

                <field name="receipt_book_id" readonly="1" />
                <field name="receipt_number" />
                <field name="reason" />
                <field name="resolved"/>
                <field name="company_id" />

            </list>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Form View -->
    <!-- ========================================================= -->

    <record id="view_receipt_exception_form" model="ir.ui.view">
        <field name="name">receipt.exception.form</field>
        <field name="model">receipt.exception</field>
        <field name="arch" type="xml">

            <form string="Receipt Exception" create="0">

                <sheet>

                    <group>

                        <group>

                            <field name="receipt_book_id" />

                            <field name="receipt_number" readonly="1" />

                        </group>

                        <group>

                            <field name="reason" readonly="1" />

                            <field name="company_id" readonly="1" />

                        </group>

                    </group>

                    <group>

                        <field name="description" placeholder="Additional notes..." />
                        <group string="Resolution"
                            invisible="not resolved">

                            <group>

                                <field name="resolved" readonly="1" />

                            </group>

                            <group>

                                <field name="resolved_by" readonly="1" />

                                <field name="resolved_date" readonly="1" />

                            </group>

                        </group>
                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Search View -->
    <!-- ========================================================= -->

    <record id="view_receipt_exception_search" model="ir.ui.view">
        <field name="name">receipt.exception.search</field>
        <field name="model">receipt.exception</field>
        <field name="arch" type="xml">

            <search>

                <field name="receipt_book_id" />
                <field name="receipt_number" />
                <field name="reason" />

                <separator />

                <group expand="0" string="Group By">

                    <filter string="Receipt Book"
                        name="group_book"
                        context="{'group_by':'receipt_book_id'}" />

                    <filter string="Reason"
                        name="group_reason"
                        context="{'group_by':'reason'}" />

                    <filter string="Company"
                        name="group_company"
                        context="{'group_by':'company_id'}" />

                </group>

            </search>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Action -->
    <!-- ========================================================= -->

    <record id="action_receipt_exception" model="ir.actions.act_window">
        <field name="name">Receipt Exceptions</field>
        <field name="res_model">receipt.exception</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_receipt_exception_search" />
    </record>

</odoo>