<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_project_form_qaqc" model="ir.ui.view">
        <field name="name">project.project.form.qaqc</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="QA/QC Project Info">
                    <group>
                        <field name="project_code"/>
                        <field name="project_no"/>
                        <field name="contractor_code"/>
                    </group>
                    <group>
                        <field name="employer_id"/>
                        <field name="engineer_id"/>
                        <field name="contractor_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
