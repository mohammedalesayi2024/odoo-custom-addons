<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_audit_log_list" model="ir.ui.view">
        <field name="name">audit.log.list</field>
        <field name="model">audit.log</field>
        <field name="arch" type="xml">
            <list string="سجل التدقيق" create="false" edit="false" delete="false">
                <field name="log_date"/>
                <field name="user_id"/>
                <field name="model_label"/>
                <field name="record_name"/>
                <field name="method" decoration-success="method == 'create'"
                       decoration-info="method == 'write'"
                       decoration-danger="method == 'unlink'"/>
            </list>
        </field>
    </record>

    <record id="view_audit_log_form" model="ir.ui.view">
        <field name="name">audit.log.form</field>
        <field name="model">audit.log</field>
        <field name="arch" type="xml">
            <form string="تفاصيل سجل التدقيق" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="log_date"/>
                            <field name="user_id"/>
                            <field name="method"/>
                        </group>
                        <group>
                            <field name="model_label"/>
                            <field name="model_name"/>
                            <field name="res_id"/>
                            <field name="record_name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="تفاصيل التغييرات">
                            <field name="field_changes_ids">
                                <list editable="false" create="false" delete="false">
                                    <field name="field_label"/>
                                    <field name="old_value"/>
                                    <field name="new_value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_audit_log_search" model="ir.ui.view">
        <field name="name">audit.log.search</field>
        <field name="model">audit.log</field>
        <field name="arch" type="xml">
            <search string="بحث في سجل التدقيق">
                <field name="user_id"/>
                <field name="model_label"/>
                <field name="record_name"/>
                <field name="log_date"/>
                <filter string="اليوم" name="today"
                        domain="[('log_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="آخر 7 أيام" name="last_7_days"
                        domain="[('log_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <filter string="إضافة" name="filter_create" domain="[('method', '=', 'create')]"/>
                <filter string="تعديل" name="filter_write" domain="[('method', '=', 'write')]"/>
                <filter string="حذف" name="filter_unlink" domain="[('method', '=', 'unlink')]"/>
                <group expand="0" string="تجميع حسب">
                    <filter string="المستخدم" name="group_by_user" context="{'group_by': 'user_id'}"/>
                    <filter string="الموديل" name="group_by_model" context="{'group_by': 'model_label'}"/>
                    <filter string="نوع العملية" name="group_by_method" context="{'group_by': 'method'}"/>
                    <filter string="اليوم" name="group_by_day" context="{'group_by': 'log_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_audit_log" model="ir.actions.act_window">
        <field name="name">سجل التدقيق</field>
        <field name="res_model">audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_audit_log_search"/>
        <field name="context">{'search_default_last_7_days': 1}</field>
    </record>

    <menuitem id="menu_audit_root" name="التدقيق" sequence="90" groups="group_audit_viewer"/>
    <menuitem id="menu_audit_log" name="سجل التدقيق" parent="menu_audit_root"
              action="action_audit_log" sequence="10"/>

</odoo>
