<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_audit_tracked_model_list" model="ir.ui.view">
        <field name="name">audit.tracked.model.list</field>
        <field name="model">audit.tracked.model</field>
        <field name="arch" type="xml">
            <list string="الموديلات المتتبَّعة" editable="bottom">
                <field name="model_id"/>
                <field name="model_name"/>
                <field name="active"/>
                <field name="track_create"/>
                <field name="track_write"/>
                <field name="track_unlink"/>
            </list>
        </field>
    </record>

    <record id="action_audit_tracked_model" model="ir.actions.act_window">
        <field name="name">إعداد الموديلات المتتبَّعة</field>
        <field name="res_model">audit.tracked.model</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_audit_config" name="إعدادات التتبع" parent="menu_audit_root"
              action="action_audit_tracked_model" groups="group_audit_manager" sequence="20"/>

</odoo>
