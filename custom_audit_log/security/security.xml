<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_audit" model="ir.module.category">
        <field name="name">التدقيق</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_audit_viewer" model="res.groups">
        <field name="name">مشاهدة سجلات التدقيق</field>
        <field name="category_id" ref="module_category_audit"/>
    </record>

    <record id="group_audit_manager" model="res.groups">
        <field name="name">مدير التدقيق (إعداد الموديلات المتتبَّعة)</field>
        <field name="category_id" ref="module_category_audit"/>
        <field name="implied_ids" eval="[(4, ref('group_audit_viewer'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
