<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_receipt_book_multi" model="ir.ui.view">
        <field name="name">account.payment.form.receipt.book.multi</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="receipt_book_management.view_account_payment_form_receipt_book"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='receipt_book_id']" position="attributes">
                <attribute name="readonly">state == 'posted'</attribute>
                <attribute name="domain">[('salesperson_id', '=', salesperson_id), ('company_id', '=', company_id), ('state', '!=', 'finished')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
