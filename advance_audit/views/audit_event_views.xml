<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_advance_audit_event_list" model="ir.ui.view">
        <field name="name">advance.audit.event.list</field>
        <field name="model">advance.audit.event</field>
        <field name="arch" type="xml">
            <list string="Audit Events" create="false" delete="false">
                <field name="record_name"/>
                <field name="user_id"/>
                <field name="event_type"/>
                <field name="model_name"/>
                <field name="event_datetime"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_advance_audit_event_form" model="ir.ui.view">
        <field name="name">advance.audit.event.form</field>
        <field name="model">advance.audit.event</field>
        <field name="arch" type="xml">
            <form string="Audit Event">
                <sheet>

                    <group>
                        <group>
                            <field name="record_name" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="event_type" readonly="1"/>
                        </group>

                        <group>
                            <field name="model_name" readonly="1"/>
                            <field name="event_datetime" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="description" readonly="1"/>
                    </group>

                    <notebook>

                        <page string="Changes">

                            <field name="change_ids" readonly="1">

                                <list create="false" delete="false">
                                    <field name="field_name"/>
                                    <field name="old_value"/>
                                    <field name="new_value"/>
                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>