<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_qaqc_prq_list" model="ir.ui.view"><field name="name">qaqc.prq.list</field><field name="model">qaqc.prq</field><field name="arch" type="xml"><list decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-info="state in ('submitted','under_review')"><field name="name"/><field name="project_id"/><field name="supplier_id"/><field name="discipline"/><field name="date"/><field name="revision"/><field name="current_responsible_user_id"/><field name="state" widget="badge"/></list></field></record>
  <record id="view_qaqc_prq_search" model="ir.ui.view"><field name="name">qaqc.prq.search</field><field name="model">qaqc.prq</field><field name="arch" type="xml"><search><field name="name"/><field name="project_id"/><field name="supplier_id"/><field name="state"/><filter name="my_pending" string="My Pending Approvals" domain="[('current_responsible_user_id', '=', uid), ('state', '=', 'under_review')]"/><group expand="0" string="Group By"><filter string="Project" context="{'group_by':'project_id'}"/><filter string="Status" context="{'group_by':'state'}"/></group></search></field></record>
  <record id="view_qaqc_prq_form" model="ir.ui.view"><field name="name">qaqc.prq.form</field><field name="model">qaqc.prq</field><field name="arch" type="xml"><form><header>
    <button name="action_submit" string="Submit for Approval" type="object" class="oe_highlight" invisible="state not in ('draft','revise_resubmit')" groups="qaqc_prq_workflow.group_qaqc_user"/>
    <button name="action_start_review" string="Start Review" type="object" invisible="state != 'submitted'" groups="qaqc_prq_workflow.group_qaqc_reviewer"/>
    <button name="action_approve_step" string="Approve / Complete Step" type="object" class="oe_highlight" invisible="state != 'under_review'" groups="qaqc_prq_workflow.group_qaqc_reviewer"/>
    <button name="action_return_for_changes" string="Return for Changes" type="object" invisible="state not in ('submitted','under_review')" groups="qaqc_prq_workflow.group_qaqc_reviewer"/>
    <button name="action_reject" string="Reject" type="object" invisible="state not in ('submitted','under_review')" groups="qaqc_prq_workflow.group_qaqc_reviewer"/>
    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state not in ('rejected','cancelled','revise_resubmit')" groups="qaqc_prq_workflow.group_qaqc_manager"/>
    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('approved','rejected','cancelled')" groups="qaqc_prq_workflow.group_qaqc_user"/>
    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_review,revise_resubmit,approved,rejected"/>
  </header><sheet><div class="oe_title"><label for="name"/><h1><field name="name" readonly="1"/></h1></div>
    <group><group><field name="project_id" readonly="state not in ('draft','revise_resubmit')"/><field name="supplier_id" readonly="state not in ('draft','revise_resubmit')"/><field name="discipline" readonly="state not in ('draft','revise_resubmit')"/><field name="scope_description" readonly="state not in ('draft','revise_resubmit')"/></group><group><field name="date" readonly="state not in ('draft','revise_resubmit')"/><field name="revision"/><field name="prepared_by_id"/><field name="workflow_id"/><field name="current_responsible_user_id" string="Current Responsible User"/><field name="consultant_rep_id"/></group></group>
    <notebook><page string="Qualification Documents"><group><field name="company_profile" filename="company_profile_fname" readonly="state not in ('draft','revise_resubmit')"/><field name="company_profile_fname" invisible="1"/><field name="financial_statement" filename="financial_statement_fname" readonly="state not in ('draft','revise_resubmit')"/><field name="financial_statement_fname" invisible="1"/><field name="previous_projects" filename="previous_projects_fname" readonly="state not in ('draft','revise_resubmit')"/><field name="previous_projects_fname" invisible="1"/><field name="iso_certificates" filename="iso_certificates_fname" readonly="state not in ('draft','revise_resubmit')"/><field name="iso_certificates_fname" invisible="1"/><field name="other_attachments" widget="many2many_binary" readonly="state not in ('draft','revise_resubmit')"/></group></page>
    <page string="Approval History"><field name="approval_ids" readonly="1"><list><field name="run_number"/><field name="sequence"/><field name="step_name"/><field name="role"/><field name="assigned_user_id"/><field name="assigned_group_id"/><field name="state" widget="badge"/><field name="decision"/><field name="decision_by_id"/><field name="decision_date"/><field name="comments"/></list></field></page>
    <page string="Decision and Notes"><group><field name="consultant_comments"/><field name="rejection_reason" readonly="state != 'draft' and state != 'revise_resubmit'"/><field name="approved_by_id"/><field name="approval_date"/></group></page>
    <page string="Documents App"><group><field name="document_count"/><field name="document_ids" readonly="1"><list><field name="name"/><field name="folder_id"/><field name="owner_id"/><field name="attachment_id"/></list></field></group><label string="Files are linked to Documents when a folder named 'QA/QC PRQ' exists."/></page>
    </notebook></sheet><chatter/></form></field></record>
  <record id="action_qaqc_prq" model="ir.actions.act_window"><field name="name">PRQ - Supplier Pre-Qualification</field><field name="res_model">qaqc.prq</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_qaqc_prq_search"/><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create the first supplier pre-qualification request.</p><p>Configure an approval workflow before submitting a request.</p></field></record>
</odoo>
